<Window x:Class="StartupPorts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StartupPorts" Width="1190" Height="740" MinWidth="940" MinHeight="570"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,24,16,18">
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" FontSize="12" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="3,0,0,30">
                        <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource Accent}">
                            <Path Data="M 1,12 L 6,12 L 10,3 L 14,18 L 18,8 L 23,8" Stroke="White"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="StartupPorts" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="17" FontWeight="DemiBold"/>
                    </StackPanel>
                    <RadioButton x:Name="StartupNav" Style="{StaticResource Nav}" Checked="Navigate" GroupName="Pages"
                                 AutomationProperties.Name="自启管理">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 8,1 L 8,8 M 4,3 A 7,7 0 1 0 12,3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6" Width="17" Height="17" StrokeEndLineCap="Round" Margin="0,0,10,0"/>
                            <TextBlock Text="自启管理" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="PortsNav" Style="{StaticResource Nav}" Checked="Navigate" GroupName="Pages"
                                 AutomationProperties.Name="端口监控">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 1,8 L 4,8 L 6,3 L 9,13 L 12,6 L 16,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6" Width="18" Height="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Margin="0,0,9,0"/>
                            <TextBlock Text="端口监控" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="27,22,27,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,20">
                <Button DockPanel.Dock="Right" x:Name="RefreshButton" Content="刷新" VerticalAlignment="Center" Click="RefreshClicked"/>
                <Button DockPanel.Dock="Right" x:Name="AddButton" Content="＋ 添加自启项" Margin="0,0,8,0"
                        Style="{StaticResource Primary}" VerticalAlignment="Center" Click="AddClicked"/>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="自启管理" Style="{StaticResource PageTitle}"/>
                    <TextBlock x:Name="PageDescription" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                               Text="选择当前 Windows 账户登录后要运行的程序和脚本。"/>
                </StackPanel>
            </DockPanel>
            <Border x:Name="Notice" Grid.Row="1" Visibility="Collapsed" CornerRadius="8" Margin="0,0,0,12" Padding="12,7"
                    Background="#FFF4DF" BorderBrush="#EAD6AF" BorderThickness="1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" x:Name="DismissNotice" Content="关闭" Margin="10,0,0,0"
                            MinHeight="28" Padding="8,3" Click="DismissNoticeClicked"/>
                    <TextBlock x:Name="NoticeText" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </DockPanel>
            </Border>
            <Border x:Name="StartupPanel" Style="{StaticResource Card}" Grid.Row="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="False" Margin="12,11">
                        <TextBlock x:Name="TaskCount" Text="正在读取任务…" VerticalAlignment="Center" Margin="3,0" Style="{StaticResource MutedText}"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button x:Name="RunButton" Content="立即运行" Click="RunClicked" Margin="4,0"/>
                            <Button x:Name="EnableButton" Content="启用 / 停用" Click="EnableClicked" Margin="4,0"/>
                            <Button x:Name="EditButton" Content="编辑" Click="EditClicked" Margin="4,0"/>
                            <Button x:Name="DeleteButton" Content="删除" Click="DeleteClicked" Margin="4,0,0,0"
                                    Foreground="{StaticResource Danger}"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="StartupGrid" Grid.Row="1" SelectionChanged="SelectionChanged"
                              MouseDoubleClick="EditDoubleClicked" AutomationProperties.Name="自启任务">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="1.25*" MinWidth="100" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="登录自启" Binding="{Binding Enabled}" Width="85" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="延迟" Binding="{Binding Delay}" Width="68" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="预期端口" Binding="{Binding Port}" Width="1.4*" MinWidth="125" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="最近启动" Binding="{Binding Status}" Width="1.3*" MinWidth="115" ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel x:Name="StartupEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="还没有自启项" FontSize="19" FontWeight="DemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="添加一个程序或脚本，也可从端口监控页选择正在监听的进程。"
                                   Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,10">
                        <TextBlock x:Name="TaskDetails" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </Border>
                </Grid>
            </Border>
            <Border x:Name="PortsPanel" Grid.Row="2" Style="{StaticResource Card}" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="12,11" LastChildFill="True">
                        <ComboBox x:Name="ProtocolFilter" Width="110" Margin="0,0,8,0" SelectedIndex="0"
                                  SelectionChanged="SearchChanged" AutomationProperties.Name="筛选协议">
                            <ComboBoxItem Content="所有协议"/>
                            <ComboBoxItem Content="TCP"/>
                            <ComboBoxItem Content="UDP"/>
                        </ComboBox>
                        <TextBlock x:Name="PortCount" DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Margin="12,0,0,0" Style="{StaticResource MutedText}"/>
                        <Grid>
                            <TextBox x:Name="SearchBox" TextChanged="SearchChanged" AutomationProperties.Name="搜索端口、进程名或 PID"/>
                            <TextBlock Text="搜索端口、进程名或 PID" Margin="9,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=SearchBox}" Value=""/>
                                                    <Condition Binding="{Binding IsKeyboardFocused, ElementName=SearchBox}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                    <DataGrid x:Name="PortGrid" Grid.Row="1" SelectionChanged="SelectionChanged" AutomationProperties.Name="本机端口">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="62" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="62" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="绑定地址" Binding="{Binding Address}" Width="1.25*" MinWidth="105" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="进程" Binding="{Binding Process}" Width="1.5*" MinWidth="110" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="72" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="来源" Binding="{Binding OriginDisplay}" Width="1.1*" MinWidth="80" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="CPU" Binding="{Binding CpuDisplay}" SortMemberPath="Cpu" Width="66" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="内存" Binding="{Binding MemoryDisplay}" SortMemberPath="Memory" Width="94" ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="PortsEmpty" Grid.Row="1" Text="没有匹配的端口" HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontSize="17" Style="{StaticResource MutedText}" Visibility="Collapsed"/>
                    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="CopyButton" Content="复制地址" Click="CopyClicked" Margin="4,0"/>
                                <Button x:Name="OpenButton" Content="浏览器打开" Click="OpenClicked" Margin="4,0"/>
                                <Button x:Name="FromPortButton" Content="添加为自启项" Click="FromPortClicked" Margin="4,0"/>
                                <Button x:Name="EndButton" Content="结束进程" Foreground="{StaticResource Danger}" Click="EndClicked" Margin="4,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="PortDetails" VerticalAlignment="Center" Margin="4,0,8,0" Style="{StaticResource MutedText}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
            <TextBlock Grid.Row="3" x:Name="StatusText" Style="{StaticResource MutedText}" Margin="2,10,0,0"
                       Text="正在读取本机状态…" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/>
        </Grid>
    </Grid>
</Window>
