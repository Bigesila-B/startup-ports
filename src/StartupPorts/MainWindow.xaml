<Window x:Class="StartupPorts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StartupPorts" Width="1190" Height="740" MinWidth="940" MinHeight="570"
        Icon="Assets/StartupPorts.ico"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,24,16,18">
                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="UpdatesButton" Content="{DynamicResource CheckForUpdates}" Margin="0,0,0,14" Click="OpenUpdatesClicked"/>
                    <TextBlock Text="{DynamicResource UiLanguage}" Style="{StaticResource MutedText}" FontSize="12" Margin="8,0,0,5"/>
                    <ComboBox x:Name="LanguageSelector" Margin="0,0,0,12" SelectedValuePath="Tag"
                              AutomationProperties.Name="{DynamicResource UiLanguage}">
                        <ComboBoxItem Tag="zh-CN" Content="简体中文"/>
                        <ComboBoxItem Tag="en-US" Content="English"/>
                    </ComboBox>
                    <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" FontSize="12" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="3,0,0,30">
                        <Image Source="Assets/StartupPorts.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="StartupPorts" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="17" FontWeight="DemiBold"/>
                    </StackPanel>
                    <RadioButton x:Name="StartupNav" Style="{StaticResource Nav}" Checked="Navigate" GroupName="Pages"
                                 AutomationProperties.Name="{DynamicResource StartupApps}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 8,1 L 8,8 M 4,3 A 7,7 0 1 0 12,3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6" Width="17" Height="17" StrokeEndLineCap="Round" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource StartupApps}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="GroupsNav" Style="{StaticResource Nav}" Checked="Navigate" GroupName="Pages"
                                 AutomationProperties.Name="{DynamicResource StartupGroups}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 1,4 H 7 L 9,6 H 17 V 15 H 1 Z" Width="17" Height="17" Margin="0,0,10,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6" StrokeLineJoin="Round"/>
                            <TextBlock Text="{DynamicResource StartupGroups}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="WindowsStartupNav" Style="{StaticResource Nav}" Checked="Navigate" GroupName="Pages"
                                 AutomationProperties.Name="{DynamicResource WindowsStartupItems}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 1,2 L 17,2 L 17,13 L 1,13 Z M 7,16 L 11,16 M 9,13 L 9,16" Width="18" Height="17"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round" Margin="0,0,9,0"/>
                            <TextBlock Text="{DynamicResource WindowsStartupItems}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="PortsNav" Style="{StaticResource Nav}" Checked="Navigate" GroupName="Pages"
                                 AutomationProperties.Name="{DynamicResource PortMonitor}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 1,8 L 4,8 L 6,3 L 9,13 L 12,6 L 16,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6" Width="18" Height="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Margin="0,0,9,0"/>
                            <TextBlock Text="{DynamicResource PortMonitor}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="27,22,27,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,20">
                <Button DockPanel.Dock="Right" x:Name="RefreshButton" Content="{DynamicResource Refresh}" VerticalAlignment="Center" Click="RefreshClicked"/>
                <Button DockPanel.Dock="Right" x:Name="AddButton" Content="{DynamicResource AddButton}" Margin="0,0,8,0"
                        Style="{StaticResource Primary}" VerticalAlignment="Center" Click="AddClicked"/>
                <Button DockPanel.Dock="Right" x:Name="NewGroupButton" Content="{DynamicResource NewGroup}" Margin="0,0,8,0"
                        Style="{StaticResource Primary}" VerticalAlignment="Center" Click="NewGroupClicked" Visibility="Collapsed"/>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="{DynamicResource StartupApps}" Style="{StaticResource PageTitle}"/>
                    <TextBlock x:Name="PageDescription" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                               Text="{DynamicResource StartupPageDescription}"/>
                </StackPanel>
            </DockPanel>
            <Border x:Name="Notice" Grid.Row="1" Visibility="Collapsed" CornerRadius="8" Margin="0,0,0,12" Padding="12,7"
                    Background="#FFF4DF" BorderBrush="#EAD6AF" BorderThickness="1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" x:Name="DismissNotice" Content="{DynamicResource Close}" Margin="10,0,0,0"
                            MinHeight="28" Padding="8,3" Click="DismissNoticeClicked"/>
                    <TextBlock x:Name="NoticeText" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </DockPanel>
            </Border>
            <Border x:Name="StartupPanel" Style="{StaticResource Card}" Grid.Row="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="False" Margin="12,10">
                        <TextBlock x:Name="TaskCount" Text="{DynamicResource ReadingTasks}" VerticalAlignment="Center" Margin="3,0" Style="{StaticResource MutedText}"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button x:Name="RunButton" Content="{DynamicResource RunNow}" Click="RunClicked" Margin="4,0"/>
                            <Button x:Name="EnableButton" Content="{DynamicResource EnableDisable}" Click="EnableClicked" Margin="4,0"/>
                            <Button x:Name="EditButton" Content="{DynamicResource Edit}" Click="EditClicked" Margin="4,0"/>
                            <Button x:Name="DeleteButton" Content="{DynamicResource Delete}" Click="DeleteClicked" Margin="4,0,0,0"
                                    Foreground="{StaticResource Danger}"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="StartupGrid" Grid.Row="1" RowHeight="52" SelectionChanged="SelectionChanged"
                              MouseDoubleClick="EditDoubleClicked" AutomationProperties.Name="{DynamicResource StartupTasks}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Name" SortMemberPath="Name" Width="1.4*" MinWidth="155">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <ContentPresenter DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource ProgramIcon}" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Style="{StaticResource CellText}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="StartAtSignIn" Binding="{Binding Enabled}" Width="85" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Delay" Binding="{Binding Delay}" Width="68" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="ExpectedPort" Binding="{Binding Port}" Width="1.4*" MinWidth="125" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="LastLaunch" Binding="{Binding Status}" Width="1.3*" MinWidth="115" ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel x:Name="StartupEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource NoStartupTasks}" FontSize="19" FontWeight="DemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource StartupEmptyHint}"
                                   Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,10">
                        <TextBlock x:Name="TaskDetails" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </Border>
                </Grid>
            </Border>
            <Grid x:Name="GroupsPanel" Grid.Row="2" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*" MinWidth="323"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="GroupCollection" Grid.ColumnSpan="3" Style="{StaticResource Card}" Background="#F8FAFE">
                    <Grid>
                        <ListBox x:Name="GroupsList" Margin="12" Background="Transparent" BorderThickness="0" Padding="0"
                                 SelectionChanged="GroupSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False"
                                 AutomationProperties.Name="{DynamicResource StartupGroups}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                    <Setter Property="ToolTip" Value="{Binding Tooltip}"/>
                                    <Setter Property="Margin" Value="0,0,8,9"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="GroupCard" Width="142" Padding="11" Background="White" CornerRadius="12"
                                                        BorderBrush="{StaticResource Line}" BorderThickness="2">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="GroupCard" Property="BorderBrush" Value="#9AB0ED"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="GroupCard" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                        <Setter TargetName="GroupCard" Property="Background" Value="#F3F6FF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="GroupCard" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid Height="78">
                                            <Path Data="M 5,17 Q 5,11 11,11 H 38 Q 42,11 46,16 L 51,22 H 98 Q 105,22 105,29 V 69 Q 105,76 98,76 H 12 Q 5,76 5,69 Z"
                                                  Stretch="Uniform" Width="107" Height="75" Fill="#E7EEFF" Stroke="#CEDAFA" StrokeThickness="1.3"/>
                                            <ItemsControl ItemsSource="{Binding Preview}" Height="52" Width="56" Margin="0,9,0,0"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="2" Rows="2"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Viewbox Width="24" Height="24" ToolTip="{Binding Name}">
                                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ProgramIcon}"/>
                                                        </Viewbox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding Overflow}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                       Foreground="{StaticResource Accent}" FontSize="10" FontWeight="SemiBold" Margin="0,0,14,8"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" Margin="0,8,0,2" FontSize="14" FontWeight="DemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding MemberCount}" FontSize="12" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="GroupsEmpty" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed">
                            <Path Data="M 2,6 H 14 L 18,10 H 34 V 29 H 2 Z" Stroke="#9AB0ED" StrokeThickness="1.8"
                                  Fill="#E7EEFF" StrokeLineJoin="Round" Width="37" Height="35"/>
                            <TextBlock Text="{DynamicResource NoGroups}" FontSize="17" FontWeight="DemiBold" HorizontalAlignment="Center" Margin="0,7,0,4"/>
                            <TextBlock Text="{DynamicResource NoGroupsHint}" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource MutedText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="GroupDetails" Grid.Column="2" Style="{StaticResource Card}" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="16,14,16,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" x:Name="EditGroupButton" Content="{DynamicResource EditGroup}"
                                        Click="EditGroupClicked" Padding="10,4" MinHeight="30" Margin="8,0,0,0"/>
                                <TextBlock x:Name="GroupTitle" VerticalAlignment="Center" FontSize="22" FontWeight="DemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </DockPanel>
                            <TextBlock x:Name="GroupSummary" Style="{StaticResource MutedText}" Margin="0,3,0,11"/>
                            <Button x:Name="RunGroupButton" Content="{DynamicResource RunGroup}" Click="RunGroupClicked" Style="{StaticResource Primary}"/>
                            <Border Margin="0,9,0,0" Padding="10,7" Background="#F3F6FD" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource GroupSignIn}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <UniformGrid Columns="2">
                                        <Button x:Name="EnableGroupButton" Content="{DynamicResource EnableGroup}" Click="EnableGroupClicked" Margin="0,0,3,0" Padding="7,4" MinHeight="29"/>
                                        <Button x:Name="DisableGroupButton" Content="{DynamicResource DisableGroup}" Click="DisableGroupClicked" Margin="3,0,0,0" Padding="7,4" MinHeight="29"/>
                                    </UniformGrid>
                                    <TextBlock Text="{DynamicResource GroupSharedHint}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="16,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource GroupChoices}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ListBox x:Name="GroupMembersList" Grid.Row="1" BorderThickness="0" Padding="0" Background="Transparent"
                                     Focusable="False" IsTabStop="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="{DynamicResource GroupChoices}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Padding="0,5" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Border x:Name="MemberBadge" DockPanel.Dock="Right" Background="#F0F3F8" Padding="7,2" CornerRadius="8" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock x:Name="MemberStatus" Text="{DynamicResource Disabled}" Style="{StaticResource MutedText}" FontSize="11"/>
                                            </Border>
                                            <Viewbox DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,8,0">
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ProgramIcon}"/>
                                            </Viewbox>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       ToolTip="{Binding Entry.Target}"/>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Entry.Enabled}" Value="True">
                                                <Setter TargetName="MemberBadge" Property="Background" Value="#E8F5EF"/>
                                                <Setter TargetName="MemberStatus" Property="Foreground" Value="#226341"/>
                                                <Setter TargetName="MemberStatus" Property="Text" Value="{DynamicResource Enabled}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="GroupMembersEmpty" Grid.Row="1" Text="{DynamicResource EmptyGroup}" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                        <DockPanel Grid.Row="2" Margin="16,8,16,12">
                            <Button x:Name="DeleteGroupButton" DockPanel.Dock="Right" Content="{DynamicResource DeleteGroup}"
                                    Click="DeleteGroupClicked" Foreground="{StaticResource Danger}" Padding="10,4" MinHeight="30"/>
                            <Button x:Name="AddGroupItemButton" DockPanel.Dock="Left" Content="{DynamicResource AddGroupItem}"
                                    Click="AddGroupItemClicked" Padding="10,4" MinHeight="30"/>
                            <Border/>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
            <Border x:Name="WindowsStartupPanel" Style="{StaticResource Card}" Grid.Row="2" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="12,11">
                        <Button DockPanel.Dock="Right" Content="{DynamicResource OpenWindowsStartupSettings}" Click="OpenWindowsStartupSettings"/>
                        <TextBlock x:Name="WindowsStartupCount" Text="{DynamicResource ReadingStartupItems}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="3,0"/>
                    </DockPanel>
                    <DataGrid x:Name="WindowsStartupGrid" Grid.Row="1" RowHeight="53" SelectionChanged="SelectionChanged"
                              AutomationProperties.Name="{DynamicResource RegisteredWindowsStartup}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Name" SortMemberPath="Name" Width="1.25*" MinWidth="175">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="47"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter x:Name="ProgramBadge" Content="{Binding}" ContentTemplate="{StaticResource ProgramIcon}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" Style="{StaticResource CellText}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="91" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="152" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="90" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="CommandOrPath" Binding="{Binding Command}" Width="1.7*" MinWidth="135" ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="WindowsStartupEmpty" Grid.Row="1" Text="{DynamicResource NoWindowsStartupItems}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"
                               Style="{StaticResource MutedText}" Visibility="Collapsed"/>
                    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10,8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" x:Name="CopyStartupButton" Content="{DynamicResource CopyCommandOrPath}" Click="CopyStartupClicked"/>
                            <TextBlock x:Name="WindowsStartupDetails" VerticalAlignment="Center" Margin="4,0,8,0"
                                       Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
            <Border x:Name="PortsPanel" Grid.Row="2" Style="{StaticResource Card}" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="12,11" LastChildFill="True">
                        <ComboBox x:Name="ProtocolFilter" Width="110" Margin="0,0,8,0" SelectedIndex="0"
                                  SelectionChanged="SearchChanged" AutomationProperties.Name="{DynamicResource FilterProtocol}">
                            <ComboBoxItem Content="{DynamicResource AllProtocols}"/>
                            <ComboBoxItem Content="TCP"/>
                            <ComboBoxItem Content="UDP"/>
                        </ComboBox>
                        <ComboBox x:Name="OwnerFilter" Width="130" Margin="0,0,8,0" SelectedIndex="0"
                                  SelectionChanged="SearchChanged" AutomationProperties.Name="{DynamicResource FilterOwner}">
                            <ComboBoxItem Content="{DynamicResource AllProcesses}"/>
                            <ComboBoxItem Content="{DynamicResource CurrentUser}"/>
                            <ComboBoxItem Content="{DynamicResource OtherOrUnknown}"/>
                        </ComboBox>
                        <TextBlock x:Name="PortCount" DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Margin="12,0,0,0" Style="{StaticResource MutedText}"/>
                        <Grid>
                            <TextBox x:Name="SearchBox" TextChanged="SearchChanged" AutomationProperties.Name="{DynamicResource SearchPorts}"/>
                            <TextBlock Text="{DynamicResource SearchPorts}" Margin="9,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=SearchBox}" Value=""/>
                                                    <Condition Binding="{Binding IsKeyboardFocused, ElementName=SearchBox}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                    <DataGrid x:Name="PortGrid" Grid.Row="1" SelectionChanged="SelectionChanged"
                              RowHeight="58" AutomationProperties.Name="{DynamicResource LocalPorts}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Process" SortMemberPath="Name" Width="1.8*" MinWidth="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="47"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter x:Name="ProgramBadge" Content="{Binding}" ContentTemplate="{StaticResource ProgramIcon}"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Style="{StaticResource CellText}"/>
                                                <TextBlock Text="{Binding ProcessSummary}" FontSize="11" Foreground="{StaticResource Muted}"
                                                           Style="{StaticResource CellText}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="62" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="62" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="BindAddress" Binding="{Binding Address}" Width="1.25*" MinWidth="105" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Origin}" Width="1.05*" MinWidth="96" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Cpu" Binding="{Binding CpuDisplay}" SortMemberPath="Cpu" Width="66" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Memory" Binding="{Binding MemoryDisplay}" SortMemberPath="Memory" Width="94" ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="PortsEmpty" Grid.Row="1" Text="{DynamicResource NoMatchingPorts}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontSize="17" Style="{StaticResource MutedText}" Visibility="Collapsed"/>
                    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="CopyButton" Content="{DynamicResource CopyAddress}" Click="CopyClicked" Margin="4,0"/>
                                <Button x:Name="OpenButton" Content="{DynamicResource OpenInBrowser}" Click="OpenClicked" Margin="4,0"/>
                                <Button x:Name="FromPortButton" Content="{DynamicResource AddFromPort}" Click="FromPortClicked" Margin="4,0"/>
                                <Button x:Name="EndButton" Content="{DynamicResource EndProcess}" Foreground="{StaticResource Danger}" Click="EndClicked" Margin="4,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="PortDetails" VerticalAlignment="Center" Margin="4,0,8,0" Style="{StaticResource MutedText}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
            <TextBlock Grid.Row="3" x:Name="StatusText" Style="{StaticResource MutedText}" Margin="2,10,0,0"
                       Text="{DynamicResource ReadingLocalState}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/>
        </Grid>
    </Grid>
</Window>
