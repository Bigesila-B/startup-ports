<Window x:Class="StartupPorts.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource CheckForUpdates}" Width="515" SizeToContent="Height"
        Icon="Assets/StartupPorts.ico" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13">
    <StackPanel Margin="25">
        <TextBlock Text="{DynamicResource CheckForUpdates}" Style="{StaticResource PageTitle}" FontSize="25"/>
        <TextBlock x:Name="CurrentVersionText" Style="{StaticResource MutedText}" Margin="0,5,0,13"/>
        <Border Style="{StaticResource Card}" Padding="14">
            <StackPanel>
                <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                <ProgressBar x:Name="UpdateProgress" Maximum="100" Height="7" Margin="0,10,0,0" Visibility="Collapsed"
                             AutomationProperties.Name="{DynamicResource DownloadUpdate}"/>
            </StackPanel>
        </Border>
        <CheckBox x:Name="AutoCheck" Content="{DynamicResource CheckUpdatesAtStartup}" Margin="0,14,0,0"
                  Click="SaveStartupCheck"/>
        <WrapPanel Margin="0,14,0,0">
            <Button x:Name="NotesButton" Content="{DynamicResource ViewReleaseNotes}" Click="ViewNotesClicked"
                    Margin="0,0,6,6" Visibility="Collapsed"/>
            <Button x:Name="CheckButton" Content="{DynamicResource CheckNow}" Click="CheckClicked" Margin="0,0,6,6"/>
            <Button x:Name="DownloadButton" Content="{DynamicResource DownloadUpdate}" Click="DownloadClicked"
                    Margin="0,0,6,6" Visibility="Collapsed"/>
            <Button x:Name="InstallerButton" Content="{DynamicResource OpenUpdateInstaller}" Click="InstallClicked"
                    Style="{StaticResource Primary}" Margin="0,0,6,6" Visibility="Collapsed"/>
        </WrapPanel>
        <Button Content="{DynamicResource Close}" HorizontalAlignment="Right" IsCancel="True" Width="78" Margin="0,6,0,0"/>
    </StackPanel>
</Window>
