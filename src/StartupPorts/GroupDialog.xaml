<Window x:Class="StartupPorts.GroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="570" Height="530" MinWidth="440" MinHeight="410" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Icon="Assets/StartupPorts.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Heading" FontSize="24" FontWeight="DemiBold" Margin="0,0,0,15"/>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,10">
                    <Label Content="{DynamicResource GroupName}" Target="{Binding ElementName=NameBox}" Padding="0,0,0,4"/>
                    <TextBox x:Name="NameBox" MaxLength="100" Margin="0,0,0,10"/>
                    <TextBlock Text="{DynamicResource GroupChoices}" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource GroupChoicesHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <ListBox x:Name="Choices" Grid.Row="1" Padding="2" BorderBrush="{StaticResource Line}" Background="#F8FAFE"
                         AutomationProperties.Name="{DynamicResource GroupChoices}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selected}" AutomationProperties.Name="{Binding Name}" Padding="6,5"
                                      VerticalContentAlignment="Center" ToolTip="{Binding Target}">
                                <DockPanel>
                                    <Viewbox DockPanel.Dock="Left" Width="30" Height="30" Margin="3,0,8,0">
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ProgramIcon}"/>
                                    </Viewbox>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Target}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{DynamicResource Cancel}" IsCancel="True" Margin="0,0,8,0"/>
                <Button Content="{DynamicResource Save}" Style="{StaticResource Primary}" IsDefault="True" Click="SaveClicked"/>
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" Margin="0,0,10,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
