<UserControl x:Class="StartupPorts.PowerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.3*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="19,15,19,19">
                    <TextBlock Text="{DynamicResource PowerSetTimer}" FontSize="21" FontWeight="DemiBold" Margin="0,0,0,16"/>
                    <Label Padding="0,0,0,4" Content="{DynamicResource PowerActionLabel}" Target="{Binding ElementName=Actions}"/>
                    <ComboBox x:Name="Actions" SelectedIndex="0" SelectionChanged="InputChanged" Margin="0,0,0,12">
                        <ComboBoxItem Content="{DynamicResource PowerActionShutdown}"/>
                        <ComboBoxItem Content="{DynamicResource PowerActionRestart}"/>
                        <ComboBoxItem Content="{DynamicResource PowerActionSleep}"/>
                        <ComboBoxItem Content="{DynamicResource PowerActionHibernate}"/>
                    </ComboBox>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Label Padding="0,0,0,4" Content="{DynamicResource PowerDate}" Target="{Binding ElementName=DueDate}"/>
                            <DatePicker x:Name="DueDate" MinHeight="34" SelectedDateChanged="DateChanged" DateValidationError="DateInvalid"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Padding="0,0,0,4" Content="{DynamicResource PowerTime}" Target="{Binding ElementName=DueTime}"/>
                            <TextBox x:Name="DueTime" MaxLength="5" TextChanged="InputChanged"/>
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,0,0,11">
                        <Button Content="{DynamicResource PowerPreset15}" Tag="15" Click="PresetClicked" Margin="0,0,6,4" Padding="9,5"/>
                        <Button Content="{DynamicResource PowerPreset30}" Tag="30" Click="PresetClicked" Margin="0,0,6,4" Padding="9,5"/>
                        <Button Content="{DynamicResource PowerPreset60}" Tag="60" Click="PresetClicked" Margin="0,0,0,4" Padding="9,5"/>
                    </WrapPanel>
                    <Button x:Name="ScheduleButton" Content="{DynamicResource PowerSchedule}" Style="{StaticResource Primary}"
                            IsEnabled="False" Click="ScheduleClicked" Margin="0,0,0,10"/>
                    <TextBlock x:Name="FormHint" Style="{StaticResource MutedText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel Margin="19,15,19,19">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <TextBlock Text="{DynamicResource PowerContinuesAfterClose}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource PowerMissedBehavior}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{DynamicResource PowerCurrentTimer}" FontSize="21" FontWeight="DemiBold" Margin="0,0,0,15"/>
                    <TextBlock x:Name="TimerTitle" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TimerDetails" Margin="0,5,0,12" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                    <Button x:Name="CancelButton" Content="{DynamicResource PowerCancel}" Click="CancelClicked" IsEnabled="False"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
