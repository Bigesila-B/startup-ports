<Window x:Class="StartupPorts.EntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自启项" Width="610" SizeToContent="Height" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Canvas}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25">
            <TextBlock x:Name="Heading" Style="{StaticResource PageTitle}" FontSize="25" Margin="0,0,0,12"/>
            <TextBlock x:Name="ImportHint" Text="请检查启动文件。若进程由脚本启动，可以在此选择原始脚本并填写参数。"
                       Style="{StaticResource MutedText}" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Border Style="{StaticResource Card}" Padding="15,8,15,14">
                <StackPanel>
                    <Label Content="名称" Target="{Binding ElementName=NameBox}"/>
                    <TextBox x:Name="NameBox" MaxLength="100" AutomationProperties.Name="名称"/>
                    <Label Content="启动文件" Target="{Binding ElementName=TargetBox}" Margin="0,6,0,0"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="浏览…" Margin="8,0,0,0" Click="BrowseTarget"/>
                        <TextBox x:Name="TargetBox" AutomationProperties.Name="启动文件"/>
                    </DockPanel>
                    <Label Content="参数（可选）" Target="{Binding ElementName=ArgumentsBox}" Margin="0,6,0,0"/>
                    <TextBox x:Name="ArgumentsBox" MaxLength="6000" AutomationProperties.Name="参数"
                             ToolTip="按该程序的命令行语法填写；带空格的参数可用双引号括起。"/>
                    <Label Content="工作目录（留空时使用启动文件所在目录）" Target="{Binding ElementName=DirectoryBox}" Margin="0,6,0,0"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="浏览…" Margin="8,0,0,0" Click="BrowseDirectory"/>
                        <TextBox x:Name="DirectoryBox" AutomationProperties.Name="工作目录"/>
                    </DockPanel>
                    <UniformGrid Columns="3" Margin="0,6,0,0">
                        <StackPanel Margin="0,0,8,0">
                            <Label Content="启动延迟（秒）" Target="{Binding ElementName=DelayBox}"/>
                            <TextBox x:Name="DelayBox" Text="0" MaxLength="3" AutomationProperties.Name="启动延迟"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <Label Content="预期端口（可选）" Target="{Binding ElementName=PortBox}"/>
                            <TextBox x:Name="PortBox" MaxLength="5" AutomationProperties.Name="预期端口"/>
                        </StackPanel>
                        <StackPanel>
                            <Label Content="端口协议" Target="{Binding ElementName=ProtocolBox}"/>
                            <ComboBox x:Name="ProtocolBox" SelectedIndex="0" AutomationProperties.Name="端口协议">
                                <ComboBoxItem Content="TCP"/>
                                <ComboBoxItem Content="UDP"/>
                            </ComboBox>
                        </StackPanel>
                    </UniformGrid>
                    <CheckBox x:Name="EnabledBox" Content="在当前账户登录时启动" IsChecked="True" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="取消" IsCancel="True" Width="78" Margin="0,0,8,0"/>
                <Button Content="保存" IsDefault="True" Width="94" Style="{StaticResource Primary}" Click="SaveClicked"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
